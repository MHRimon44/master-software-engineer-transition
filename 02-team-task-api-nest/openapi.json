    "/tasks": {
      "get": {
        "operationId": "TasksController_findAll",
        "parameters": [
          {
            "name": "page",
            "required": false,
            "in": "query",
            "description": "Page number starting from 1",
            "schema": {
              "default": 1,
              "example": 1,
              "allOf": [{ "$ref": "#/components/schemas/Object" }]
            }
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "description": "Maximum number of tasks per page",
            "schema": {
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "example": 20,
              "allOf": [{ "$ref": "#/components/schemas/Object" }]
            }
          },
          {
            "name": "status",
            "required": false,
            "in": "query",
            "description": "Filter tasks by status",
            "schema": {
              "example": "completed",
              "type": "string",
              "enum": ["pending", "completed"]
            }
          },
          {
            "name": "sortBy",
            "required": false,
            "in": "query",
            "description": "Field used to sort the task list",
            "schema": {
              "default": "createdAt",
              "example": "createdAt",
              "type": "string",
              "enum": ["createdAt", "title"]
            }
          },
          {
            "name": "sortDirection",
            "required": false,
            "in": "query",
            "description": "Sorting direction",
            "schema": {
              "default": "desc",
              "example": "desc",
              "type": "string",
              "enum": ["asc", "desc"]
            }
          },
          {
            "name": "q",
            "required": false,
            "in": "query",
            "description": "Text search against task title",
            "schema": {
              "maxLength": 100,
              "example": "nestjs",
              "type": "string"
            }
          }
        ],
        "responses": { "200": { "description": "" } },
        "security": [{ "access-token": [] }],
        "tags": ["Tasks"]
      },
      "post": {
        "operationId": "TasksController_create",
        "parameters": [
          {
            "name": "idempotency-key",
            "required": true,
            "in": "header",
            "schema": { "type": "string" }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "description": "Optional idempotency key with a maximum length of 128 characters",
            "required": false,
            "schema": { "type": "string", "example": "create-task-abc-123" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskDto" }
            }
          }
        },
        "responses": { "201": { "description": "" } },
        "security": [{ "access-token": [] }],
        "tags": ["Tasks"]
      }
    },
    "/tasks/{id}": {
      "get": {
        "operationId": "TasksController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Positive integer task ID",
            "schema": { "example": 42, "type": "number" }
          }
        ],
        "responses": { "200": { "description": "" } },
        "security": [{ "access-token": [] }],
        "tags": ["Tasks"]
      },
      "patch": {
        "operationId": "TasksController_update",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Positive integer task ID",
            "schema": { "example": 42, "type": "number" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskDto" }
            }
          }
        },
        "responses": { "200": { "description": "" } },
        "security": [{ "access-token": [] }],
        "tags": ["Tasks"]
      }
    },
    "/projects/{projectId}/tasks": {
      "post": {
        "operationId": "ProjectTasksController_create",
        "parameters": [
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "description": "Positive integer project ID",
            "schema": { "example": 1, "type": "number" }
          },
          {
            "name": "idempotency-key",
            "required": false,
            "in": "header",
            "description": "Optional idempotency key with a maximum length of 128 characters",
            "schema": {
              "type": "string",
              "example": "create-project-task-abc-123"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateTaskDto" }
            }
          }
        },
        "responses": { "201": { "description": "" } },
        "security": [{ "access-token": [] }],
        "tags": ["ProjectTasks"]
      }
    },
    "/projects/{projectId}/tasks/{id}": {
      "patch": {
        "operationId": "ProjectTasksController_update",
        "parameters": [
          {
            "name": "projectId",
            "required": true,
            "in": "path",
            "description": "Positive integer project ID",
            "schema": { "example": 1, "type": "number" }
          },
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "Positive integer task ID",
            "schema": { "example": 1, "type": "number" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateTaskDto" }
            }
          }
        },
        "responses": { "200": { "description": "" } },
        "security": [{ "access-token": [] }],
        "tags": ["ProjectTasks"]
      }
    }
  },
  "info": {
    "title": "Team Task API",
    "description": "Team Task API development documentation",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Team Platform",
            "description": "Human-readable project name",
            "maxLength": 100
          }
        },
        "required": ["name"]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "Unique email address of the user"
          },
          "password": {
            "type": "string",
            "example": "strong-password",
            "description": "Password used to create the account",
            "minLength": 8,
            "maxLength": 72
          }
        },
        "required": ["email", "password"]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com",
            "description": "Registered user email"
          },
          "password": {
            "type": "string",
            "example": "strong-password",
            "description": "Account password"
          }
        },
        "required": ["email", "password"]
      },
      "RefreshTokenDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
            "description": "Refresh token returned from login or refresh"
          }
        },
        "required": ["refreshToken"]
      },
      "Object": { "type": "object", "properties": {} },
      "CreateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Learn NestJS authentication",
            "description": "Human-readable task title",
            "maxLength": 120
          }
        },
        "required": ["title"]
      },
      "UpdateTaskDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "example": "Finish NestJS authentication",
            "description": "Updated task title",
            "maxLength": 120
          },
          "completed": {
            "type": "boolean",
            "example": true,
            "description": "Whether the task is completed"
          }
        }
      }
    }
  }
}
