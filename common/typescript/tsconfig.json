{
  "compilerOptions": {
    "rootDir": "../../days",
    "outDir": "./dist",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "moduleDetection": "force"
  },

  "include": ["../../days/day-*/dsa/**/*.ts"],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "**/*.spec.ts",
    "**/*.test.ts",
    "**/*.e2e-spec.ts",
    "../../days/day-*/auth/**",
    "../../days/day-*/tasks/**",
    "../../days/day-*/projects/**",
    "../../days/day-*/users/**",
    "../../days/day-*/test/**"
  ]
}
